{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WhatCable physical USB profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "root", "members"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "description": { "type": "string" },
    "physicalType": { "type": "string" },
    "physicalName": { "type": "string" },
    "physicalVendor": { "type": "string" },
    "physicalIdentitySource": { "type": "string", "enum": ["none", "profile", "user", "deterministic"] },
    "physicalConfidence": { "type": "string", "enum": ["none", "possible", "probable", "exact"] },
    "relationshipSource": { "type": "string", "enum": ["none", "hardware", "profile", "user"] },
    "root": { "$ref": "#/$defs/root" },
    "members": {
      "type": "array",
      "items": { "$ref": "#/$defs/member" }
    }
  },
  "$defs": {
    "vidPid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vid", "pid"],
      "properties": {
        "vid": { "type": "string", "pattern": "^[0-9a-f]{4}$" },
        "pid": { "type": "string", "pattern": "^[0-9a-f]{4}$" }
      }
    },
    "root": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requireCompanionGroup": { "type": "boolean" },
        "requireContainerId": { "type": "boolean" },
        "exactCompanionFunctions": { "type": "boolean" },
        "companionFunctions": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/vidPid" } },
        "parentFunctions": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/vidPid" } },
        "manufacturer": { "type": "string" },
        "productDb": { "type": "string" },
        "interfaceClass": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "required": ["exactCompanionFunctions"],
            "properties": { "exactCompanionFunctions": { "const": true } }
          },
          "then": {
            "required": ["companionFunctions"],
            "properties": { "companionFunctions": { "minItems": 2, "maxItems": 2 } }
          }
        }
      ],
      "anyOf": [
        { "required": ["requireCompanionGroup"], "properties": { "requireCompanionGroup": { "const": true } } },
        { "required": ["requireContainerId"], "properties": { "requireContainerId": { "const": true } } },
        { "required": ["companionFunctions"], "properties": { "companionFunctions": { "minItems": 1 } } },
        { "required": ["parentFunctions"], "properties": { "parentFunctions": { "minItems": 1 } } },
        { "required": ["manufacturer"], "properties": { "manufacturer": { "minLength": 1 } } },
        { "required": ["productDb"], "properties": { "productDb": { "minLength": 1 } } },
        { "required": ["interfaceClass"], "properties": { "interfaceClass": { "minLength": 1 } } }
      ]
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["match", "relationship", "required"],
      "properties": {
        "match": {
          "type": "object",
          "additionalProperties": false,
          "required": ["vid", "pid"],
          "properties": {
            "vid": { "type": "string", "pattern": "^[0-9a-f]{4}$" },
            "pid": { "type": "string", "pattern": "^[0-9a-f]{4}$" },
            "logicalPort": { "type": "string", "pattern": "^(?:[1-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])$" },
            "interfaceClass": { "type": "string" }
          }
        },
        "relationship": { "const": "integrated_function" },
        "required": { "const": true }
      }
    }
  }
}
